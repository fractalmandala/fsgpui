{
	"name": "gpuix-fractalsvelte",
	"version": "0.2.0",
	"description": "Svelte custom renderer for GPUI (Zed's GPU-accelerated UI framework), via @gpuix/native",
	"type": "module",
	"license": "MIT",
	"author": "Stanislav Khromov",
	"main": "src/index.ts",
	"bin": {
		"gpuix-fractalsvelte": "bin/gpuix-fractalsvelte.js"
	},
	"exports": {
		".": {
			"browser": "./src/web.ts",
			"default": "./src/index.ts"
		},
		"./renderer": "./src/renderer.ts",
		"./plugin": "./src/plugin.ts",
		"./register": "./src/register.ts",
		"./test": "./src/test.ts",
		"./automation": "./src/automation.ts",
		"./components/*": "./src/components/*",
		"./html": {
			"types": "./src/html.d.ts"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"src",
		"bin"
	],
	"engines": {
		"node": ">=24.0.0",
		"bun": ">=1.4.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/khromov/gpuix-fractalsvelte"
	},
	"keywords": [
		"svelte",
		"gpui",
		"gpuix",
		"custom-renderer",
		"native",
		"gui",
		"node"
	],
	"scripts": {
		"typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --diagnostic-sources js,svelte --fail-on-warnings --output human",
		"lint": "eslint .",
		"check:svelte": "node --use-env-proxy scripts/svelte-mcp.ts",
		"demo": "node scripts/demo-all.ts",
		"demo:counter": "node bin/gpuix-fractalsvelte.js examples/counter/main.ts",
		"demo:tictactoe": "node bin/gpuix-fractalsvelte.js examples/tic-tac-toe/main.ts",
		"demo:hn": "node bin/gpuix-fractalsvelte.js examples/hacker-news/main.ts",
		"demo:glass": "node bin/gpuix-fractalsvelte.js examples/liquid-glass/main.ts",
		"demo:glass-ffi": "node bin/gpuix-fractalsvelte.js --experimental-ffi examples/liquid-glass-ffi/main.ts",
		"demo:styling": "node bin/gpuix-fractalsvelte.js examples/styling-playground/main.ts",
		"demo:desktop": "node bin/gpuix-fractalsvelte.js examples/desktop-apis/main.ts",
		"demo:web": "bun scripts/web.ts",
		"tutorial": "node bin/gpuix-fractalsvelte.js examples/tutorial/main.ts",
		"test": "npm run typecheck && npm run test:reorder && npm run test:smoke && npm run test:autocommit && npm run test:style && npm run test:teardown && npm run test:lifecycle && npm run test:compile && npm run test:css && npm run test:module && npm run test:vars && npm run test:scroller && npm run test:hitbox && npm run test:auxclick && npm run test:window-keys && npm run test:portal && npm run test:host && npm run test:overlay && npm run test:window && npm run test:helpers && npm run test:search && npm run test:tooltip && npm run test:automation",
		"test:vars": "node bin/gpuix-fractalsvelte.js test/vars.ts",
		"test:scroller": "node bin/gpuix-fractalsvelte.js test/scroller.ts",
		"test:hitbox": "node bin/gpuix-fractalsvelte.js test/hitbox.ts",
		"test:auxclick": "node bin/gpuix-fractalsvelte.js test/auxclick.ts",
		"test:window-keys": "node bin/gpuix-fractalsvelte.js test/window-keys.ts",
		"test:portal": "node bin/gpuix-fractalsvelte.js test/portal.ts",
		"test:host": "node bin/gpuix-fractalsvelte.js test/host.ts",
		"test:helpers": "node bin/gpuix-fractalsvelte.js test/helpers.ts",
		"test:search": "node bin/gpuix-fractalsvelte.js test/search.ts",
		"test:tooltip": "node bin/gpuix-fractalsvelte.js test/tooltip.ts",
		"test:automation": "node bin/gpuix-fractalsvelte.js test/automation.ts",
		"test:automation-live": "node bin/gpuix-fractalsvelte.js test/automation-live.ts",
		"test:reorder": "node bin/gpuix-fractalsvelte.js test/reorder.ts",
		"test:smoke": "node bin/gpuix-fractalsvelte.js test/smoke.ts",
		"test:autocommit": "node bin/gpuix-fractalsvelte.js test/autocommit.ts",
		"test:compile": "node bin/gpuix-fractalsvelte.js test/compile.ts",
		"test:css": "node bin/gpuix-fractalsvelte.js test/css.ts",
		"test:module": "node bin/gpuix-fractalsvelte.js test/module.ts",
		"test:lifecycle": "node bin/gpuix-fractalsvelte.js test/lifecycle.ts",
		"test:teardown": "node bin/gpuix-fractalsvelte.js test/teardown.ts",
		"test:overlay": "node bin/gpuix-fractalsvelte.js test/overlay.ts",
		"test:style": "node bin/gpuix-fractalsvelte.js test/style.ts",
		"test:window": "node bin/gpuix-fractalsvelte.js test/window.ts",
		"test:coverage": "node bin/gpuix-fractalsvelte.js test/coverage.ts",
		"docs": "node scripts/docs.ts",
		"docs:serve": "node scripts/docs.ts --serve",
		"og": "node scripts/og.ts",
		"og:docs": "node scripts/docs.ts && node scripts/og.ts --root dist/docs --path overview.html --out docs/assets/og-docs.png",
		"vendor": "node --use-env-proxy scripts/vendor-svelte.ts",
		"parity": "node scripts/native-parity.ts",
		"pack": "node scripts/publish.ts pack",
		"publish:npm": "node scripts/publish.ts publish",
		"consume": "node scripts/consume.ts",
		"consume:open": "node scripts/consume.ts --open",
		"compile": "bun scripts/compile.ts",
		"compile:app": "bun scripts/compile.ts --app",
		"bun:typecheck": "npm run typecheck",
		"bun:consume": "node scripts/consume.ts --bun",
		"bun:consume:open": "node scripts/consume.ts --bun --open",
		"bun:demo": "node scripts/demo-all.ts --bun",
		"bun:demo:counter": "node bin/gpuix-fractalsvelte.js --bun examples/counter/main.ts",
		"bun:demo:tictactoe": "node bin/gpuix-fractalsvelte.js --bun examples/tic-tac-toe/main.ts",
		"bun:demo:hn": "node bin/gpuix-fractalsvelte.js --bun examples/hacker-news/main.ts",
		"bun:demo:glass": "node bin/gpuix-fractalsvelte.js --bun examples/liquid-glass/main.ts",
		"bun:demo:glass-ffi": "node bin/gpuix-fractalsvelte.js --bun examples/liquid-glass-ffi/main.ts",
		"bun:demo:styling": "node bin/gpuix-fractalsvelte.js --bun examples/styling-playground/main.ts",
		"bun:demo:desktop": "node bin/gpuix-fractalsvelte.js --bun examples/desktop-apis/main.ts",
		"bun:tutorial": "node bin/gpuix-fractalsvelte.js --bun examples/tutorial/main.ts",
		"bun:test": "npm run bun:typecheck && npm run bun:test:reorder && npm run bun:test:smoke && npm run bun:test:autocommit && npm run bun:test:style && npm run bun:test:teardown && npm run bun:test:lifecycle && npm run bun:test:compile && npm run bun:test:css && npm run bun:test:module && npm run bun:test:vars && npm run bun:test:scroller && npm run bun:test:hitbox && npm run bun:test:auxclick && npm run bun:test:window-keys && npm run bun:test:portal && npm run bun:test:host && npm run bun:test:overlay && npm run bun:test:window && npm run bun:test:helpers && npm run bun:test:search && npm run bun:test:tooltip && npm run bun:test:automation",
		"bun:test:vars": "node bin/gpuix-fractalsvelte.js --bun test/vars.ts",
		"bun:test:scroller": "node bin/gpuix-fractalsvelte.js --bun test/scroller.ts",
		"bun:test:hitbox": "node bin/gpuix-fractalsvelte.js --bun test/hitbox.ts",
		"bun:test:auxclick": "node bin/gpuix-fractalsvelte.js --bun test/auxclick.ts",
		"bun:test:window-keys": "node bin/gpuix-fractalsvelte.js --bun test/window-keys.ts",
		"bun:test:portal": "node bin/gpuix-fractalsvelte.js --bun test/portal.ts",
		"bun:test:host": "node bin/gpuix-fractalsvelte.js --bun test/host.ts",
		"bun:test:helpers": "node bin/gpuix-fractalsvelte.js --bun test/helpers.ts",
		"bun:test:search": "node bin/gpuix-fractalsvelte.js --bun test/search.ts",
		"bun:test:tooltip": "node bin/gpuix-fractalsvelte.js --bun test/tooltip.ts",
		"bun:test:automation": "node bin/gpuix-fractalsvelte.js --bun test/automation.ts",
		"bun:test:automation-live": "node bin/gpuix-fractalsvelte.js --bun test/automation-live.ts",
		"bun:test:reorder": "node bin/gpuix-fractalsvelte.js --bun test/reorder.ts",
		"bun:test:smoke": "node bin/gpuix-fractalsvelte.js --bun test/smoke.ts",
		"bun:test:autocommit": "node bin/gpuix-fractalsvelte.js --bun test/autocommit.ts",
		"bun:test:compile": "node bin/gpuix-fractalsvelte.js --bun test/compile.ts",
		"bun:test:css": "node bin/gpuix-fractalsvelte.js --bun test/css.ts",
		"bun:test:module": "node bin/gpuix-fractalsvelte.js --bun test/module.ts",
		"bun:test:lifecycle": "node bin/gpuix-fractalsvelte.js --bun test/lifecycle.ts",
		"bun:test:teardown": "node bin/gpuix-fractalsvelte.js --bun test/teardown.ts",
		"bun:test:overlay": "node bin/gpuix-fractalsvelte.js --bun test/overlay.ts",
		"bun:test:style": "node bin/gpuix-fractalsvelte.js --bun test/style.ts",
		"bun:test:window": "node bin/gpuix-fractalsvelte.js --bun test/window.ts",
		"bun:test:coverage": "node bin/gpuix-fractalsvelte.js --bun test/coverage.ts"
	},
	"dependencies": {
		"@gpuix/native": ">=0.10.0 <0.11.0",
		"acorn": "^8.19.0",
		"svelte": "file:vendor/svelte-5.57.2-694f791.tgz"
	},
	"bundleDependencies": [
		"svelte"
	],
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/bun": "^1.4.3",
		"@types/node": "^26.6.5",
		"eslint": "^10.12.0",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"marked": "^18.1.1",
		"svelte-check": "^4.7.6",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.71.2"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/",
		"access": "public"
	}
}
